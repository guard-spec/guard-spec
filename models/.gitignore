# This prevents 2-8GB binary files from entering git history

*.onnx
*.bin
*.safetensors
tokenizer.json
tokenizer_config.json
config.json
special_tokens_map.json
vocab.txt

# Pulled by `go run ./cmd/models pull`; never commit weights
cache/
