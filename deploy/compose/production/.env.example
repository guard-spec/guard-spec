# Production compose (docker-compose.yml in this directory). Copy to .env in
# this directory, fill in, chmod 600. Never commit .env.
#
# Generate each secret separately:
#   openssl rand -hex 24        passwords (URL-safe)
#   openssl rand -hex 32        JWT_SECRET
#   openssl rand -base64 32     MFA_ENC_KEY
#
# Back up this file with the database (scripts/backup.sh copies it): the
# database is useless without GUARDSPEC_APP_PASSWORD / POSTGRES_PASSWORD, and
# every user's 2FA is lost without MFA_ENC_KEY.

# --- TLS and host names (Caddy) ---
# Gateway API and admin UI host names. For automatic HTTPS both must resolve
# to this host and ports 80 and 443 must be reachable from the internet.
GATEWAY_HOST=guard.example.com
ADMIN_HOST=guard-admin.example.com
# Your email for the ACME account (automatic HTTPS), or "internal" for
# certificates from Caddy's own CA (testing; see README.md).
CADDY_TLS=
# Client ranges allowed to reach ADMIN_HOST, space-separated, such as your
# VPN: 10.8.0.0/16 192.0.2.0/24. Default: everyone. Docker must see real
# client addresses for this (Linux with the default iptables setup does).
# ADMIN_ALLOW=0.0.0.0/0 ::/0
# Host ports Caddy publishes (the only published ports).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Secrets (required) ---
# Postgres superuser "ps": migrations and backups only. At least 12 characters.
POSTGRES_PASSWORD=
# Role guardspec_app, used by the gateway and the control plane.
GUARDSPEC_APP_PASSWORD=
# Control plane session signing key, at least 32 bytes.
JWT_SECRET=
# Encrypts TOTP 2FA secrets in the database (AES-256-GCM): 32 bytes, base64.
MFA_ENC_KEY=

# Encrypts stored prompts and answers (only stored with AUDIT_STORE_CONTENT=true
# or an organization's opt-in) with a data key per organization, AES-256-GCM.
# 32 random bytes in base64: openssl rand -base64 32. Several keys,
# comma-separated, the active one first ("2026-11:<key>,2026-05:<old key>"),
# for a rotation (control-plane keys rotate). Back it up with the database:
# without it the stored content cannot be read. MFA_ENC_KEY takes several
# keys the same way. Vault Transit instead: docs/security/README.md#encryption.
CONTENT_KEK=

# Signs the heads of the activity log's hash chains (Ed25519 seed, 32 random
# bytes in base64: openssl rand -base64 32). With it, `control-plane audit
# verify` also detects a log cut at its end or rewritten from the start.
# Keep the public key (`control-plane audit public-key`) outside this server.
AUDIT_SIGNING_KEY=
# First owner, created on the first start when both are set. At least 12
# characters; change the password after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Detection ---
# Empty: l1,l2,l3 (full). l1,l2 is light mode, about half the gateway's memory
# (docs/sizing.md).
DETECTOR_LAYERS=
# Pin or roll back a model: name@version (docs/models.md, docs/upgrade.md).
L2_MODEL=
L3_MODEL=
MODELS_MIRROR=
# Shadow mode: a candidate classifier scored on live traffic without deciding
# (pull it first with models-pull). Empty: off.
SHADOW_L2_MODEL=
# Bearer token of POST /admin/models/reload (openssl rand -hex 32). Empty:
# the endpoint is off; `docker compose kill -s HUP gateway` still reloads.
GATEWAY_ADMIN_TOKEN=

# --- Upstream LLM ---
# Empty: stub responses (useful to test the guard only).
UPSTREAM_LLM_URL=
UPSTREAM_LLM_KEY=
UPSTREAM_KEY_MAIN=
# Which orgs may use which key variable: UPSTREAM_KEY_MAIN=*;UPSTREAM_KEY_X=<org-uuid>
UPSTREAM_KEY_ORGS=

# --- Resources (docs/sizing.md) ---
# GATEWAY_CPUS=2
# GATEWAY_MEMORY=2g          # full detector peaks near 1 GiB; light mode near 0.5 GiB
# INFERENCE_MAX_CONCURRENCY=2  # keep concurrency x threads <= GATEWAY_CPUS
# INFERENCE_INTRA_OP_THREADS=1
# Large inputs: unset keeps today's limits (about 28 KB of prompt, 128 KiB of
# tool output); see README "Large inputs" before raising it.
# MAX_SCAN_TOKENS=200000
# INFERENCE_LARGE_MAX_CONCURRENCY=1   # default: a quarter of GATEWAY_CPUS, at least 1
# LARGE_SCAN_QUEUE_TIMEOUT=30s
# CONTROL_PLANE_CPUS=1
# CONTROL_PLANE_MEMORY=256m
# POSTGRES_CPUS=2
# POSTGRES_MEMORY=1g
# CADDY_CPUS=1
# CADDY_MEMORY=256m

# --- Operations ---
# Image tag of the gateway and control plane (docs/upgrade.md).
# GUARDSPEC_VERSION=0.4.2
# Container log rotation (json-file driver).
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5
# Subnet of the edge network, trusted for X-Forwarded-For from Caddy.
# EDGE_SUBNET=172.30.89.0/24
AUDIT_RETENTION_DAYS=90
# Activity log rows older than this many days; sessions revoked or expired
# more than SESSION_RETENTION_DAYS ago (active ones stay). 0 keeps them.
ACTIVITY_LOG_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=30
AUDIT_STORE_CONTENT=false
RATE_LIMIT_RPM=0
RATE_LIMIT_TPM=0
# Scan cache: memory, postgres or redis (--profile scan-cache; README, Scan
# cache). For redis set the password and the URL that repeats it.
SCAN_CACHE_BACKEND=memory
# SCAN_CACHE_REDIS_PASSWORD=<openssl rand -hex 24>
# SCAN_CACHE_REDIS_URL=redis://:<the same password>@scan-cache:6379/0

# --- Optional: SSO, alerts, tracing (see the root .env.example) ---
PUBLIC_BASE_URL=
OIDC_SECRET_GOOGLE=
ALERTS_SECRET_ORGS=
SMTP_URL=
SMTP_FROM=
OTEL_EXPORTER_OTLP_ENDPOINT=
