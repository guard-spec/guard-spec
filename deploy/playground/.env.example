# Copy to .env and fill in. Generate the secrets with:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
#   echo "GUARDSPEC_APP_PASSWORD=$(openssl rand -hex 24)"
#   echo "PLAYGROUND_GATEWAY_KEY=gs_$(openssl rand -hex 24)"
POSTGRES_PASSWORD=
GUARDSPEC_APP_PASSWORD=
PLAYGROUND_GATEWAY_KEY=

# Origins of the playground page (exact, comma-separated).
ALLOWED_ORIGINS=https://guardspec.io

# Limits per client address (token buckets) and for everyone together.
RATE_PER_MINUTE=10
RATE_PER_DAY=200
GLOBAL_RATE_PER_MINUTE=300
MAX_INPUT_BYTES=4096

# Where the client address comes from: X-Forwarded-For (bundled Caddy),
# CF-Connecting-IP (Cloudflare in front), Fly-Client-IP (Fly.io), or empty
# when clients connect to the proxy directly.
CLIENT_IP_HEADER=X-Forwarded-For

# Profile tls (Caddy): host name and ACME email, or internal for testing.
PLAYGROUND_HOST=play-api.guardspec.io
CADDY_TLS=internal

# Cloudflare Turnstile: off while empty (README, Turnstile).
TURNSTILE_SECRET=

# Gateway image: gateway-full has the L2 and L3 models inside. Per-layer
# scores need a release after 0.2.1.
# GATEWAY_IMAGE=ghcr.io/guard-spec/guard-spec-gateway-full:0.2.1
