# Copy to .env and fill in. Never commit .env.
#
# Production: run `docker compose -f docker-compose.yml up -d`. The services
# refuse to start while a secret below is empty, a known default, or too short.
#
# Local development needs none of this: `docker compose up` also loads
# docker-compose.override.yml, which sets GUARD_ENV=dev and throwaway values.
#
# Generate each secret separately, for example: openssl rand -hex 32
# Use URL-safe characters (hex is fine) for the database passwords.

# Set to "dev" only on a developer machine. Any other value is production.
GUARD_ENV=

# Database created on a fresh volume. An existing PromptShield volume keeps
# its database: set POSTGRES_DB=promptshield, and COMPOSE_PROJECT_NAME to the
# old project name (the checkout's directory name), to keep using it.
# POSTGRES_DB=guardspec
# COMPOSE_PROJECT_NAME=guard-spec

# Postgres superuser (POSTGRES_USER is "ps"). Used by migrations only.
# At least 12 characters.
POSTGRES_PASSWORD=

# Application role guardspec_app, used by the gateway and the control plane.
# (Formerly PS_APP_PASSWORD, which is still read for one release.)
# Applied to the database on every start by the db-roles service.
# At least 12 characters.
GUARDSPEC_APP_PASSWORD=

# Control plane token signing key. At least 32 bytes.
JWT_SECRET=

# First owner of the default organization, created on first start when both
# are set. At least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Two-factor authentication: encrypts TOTP secrets (AES-256-GCM). 32 random
# bytes in base64: openssl rand -base64 32. Without it 2FA cannot be turned
# on; once users have 2FA the control plane refuses to start without it.
# Back it up: losing it disables every user's 2FA.
MFA_ENC_KEY=

# External origin of the control plane (no path), used for SSO callback
# urls: <PUBLIC_BASE_URL>/v1/auth/oidc/<provider id>/callback. Needed for SSO.
PUBLIC_BASE_URL=

# Reverse proxies whose X-Forwarded-For names the client (control plane):
# comma-separated CIDRs or addresses. Empty: the header is ignored.
TRUSTED_PROXIES=

# SSO client secrets. An identity provider (Instance admin > Identity
# providers) names its variable in client_secret_env, OIDC_SECRET_<NAME>;
# add each one to the control plane's environment in docker-compose.yml.
OIDC_SECRET_GOOGLE=

# Audit rows store hashes and lengths of prompts and responses only. Set to
# true to also store the content for every organization (an organization can
# opt in by itself with PATCH /v1/organizations/{id}).
AUDIT_STORE_CONTENT=false

# Upstream LLM (optional; empty means stub responses).
UPSTREAM_LLM_URL=
UPSTREAM_LLM_KEY=
UPSTREAM_LLM_TIMEOUT=
# Keys of named upstreams (routing): an upstream with
# api_key_env: UPSTREAM_KEY_MAIN uses this variable. Add more to the gateway's
# environment in docker-compose.yml as needed.
UPSTREAM_KEY_MAIN=
# Which orgs may use which key variable, for gateway and control plane:
# UPSTREAM_KEY_MAIN=*;UPSTREAM_KEY_ACME=<org-uuid>,<org-uuid>. Empty: none.
# Compose defaults to UPSTREAM_KEY_MAIN=* (every org may use that key).
UPSTREAM_KEY_ORGS=UPSTREAM_KEY_MAIN=*
# Org-defined upstreams may reach loopback/private/CGNAT addresses (compose
# default true, for Ollama on the host). The gateway's own default is false.
UPSTREAM_ALLOW_PRIVATE=true

# Per-API-key rate limits (gateway). A key's own rpm_limit / tpm_limit, set in
# the control plane, wins; these apply to keys without one. 0 = unlimited.
# Counted in memory per gateway replica.
RATE_LIMIT_RPM=0
RATE_LIMIT_TPM=0

# Audit rows older than this many days are deleted by the control plane.
# 0 keeps them forever.
AUDIT_RETENTION_DAYS=90

# Optional OpenTelemetry tracing (OTLP/HTTP), e.g. http://otel-collector:4318.
# Empty turns tracing off. true also sends traceparent to the upstream LLM.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_PROPAGATE_UPSTREAM=false

# Host ports. The metrics ports serve /metrics only; keep them off the internet.
GATEWAY_PORT=8080
METRICS_PORT=9090
CONTROL_PLANE_PORT=18081
CONTROL_PLANE_METRICS_PORT=9091

# Optional: only for gated, optional baseline models in models/manifest.yaml.
HF_TOKEN=
